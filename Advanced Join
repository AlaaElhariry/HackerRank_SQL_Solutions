/*Interviews*/

WITH aggregated_views AS (
    SELECT 
        challenge_id,
        SUM(total_views) AS sum_tv,
        SUM(total_unique_views) AS sum_tuv
    FROM View_Stats
    GROUP BY challenge_id
),
aggregated_submission_stats AS (
    SELECT  
        challenge_id,
        SUM(total_submissions) AS sum_ts,
        SUM(total_accepted_submissions) AS sum_tas
    FROM Submission_Stats
    GROUP BY challenge_id
)

SELECT
    con.contest_id,
    con.hacker_id,
    con.name,

    SUM(ISNULL(ass.sum_ts, 0))  AS total_submissions,
    SUM(ISNULL(ass.sum_tas, 0)) AS total_accepted_submissions,
    SUM(ISNULL(av.sum_tv, 0))   AS total_views,
    SUM(ISNULL(av.sum_tuv, 0))  AS total_unique_views

FROM Contests con

JOIN Colleges col 
    ON con.contest_id = col.contest_id

JOIN Challenges cha 
    ON col.college_id = cha.college_id

LEFT JOIN aggregated_views av 
    ON av.challenge_id = cha.challenge_id

LEFT JOIN aggregated_submission_stats ass 
    ON ass.challenge_id = cha.challenge_id

GROUP BY 
    con.contest_id,
    con.hacker_id,
    con.name

HAVING 
    SUM(ISNULL(av.sum_tv, 0)) +
    SUM(ISNULL(av.sum_tuv, 0)) +
    SUM(ISNULL(ass.sum_ts, 0)) +
    SUM(ISNULL(ass.sum_tas, 0)) > 0

ORDER BY 
    con.contest_id;

