/*15 Days of Learning SQL*/

WITH s AS (
    SELECT 
        hacker_id,
        submission_date,
        ROW_NUMBER() OVER (
            PARTITION BY hacker_id 
            ORDER BY submission_date
        ) AS rn
    FROM (SELECT DISTINCT hacker_id, submission_date FROM Submissions) x
),
grp AS (
    SELECT *,
           DATEADD(DAY, -rn, submission_date) AS grp_key
    FROM s
),
valid AS (
    SELECT hacker_id, submission_date
    FROM grp
    WHERE grp_key = DATEADD(DAY, -1, '2016-03-01')
)
SELECT 
    d.submission_date,
    COUNT(DISTINCT v.hacker_id),
    (
        SELECT TOP 1 hacker_id
        FROM Submissions s2
        WHERE s2.submission_date = d.submission_date
        GROUP BY hacker_id
        ORDER BY COUNT(*) DESC, hacker_id
    ),
    (
        SELECT h.name
        FROM Hackers h
        WHERE h.hacker_id = (
            SELECT TOP 1 hacker_id
            FROM Submissions s3
            WHERE s3.submission_date = d.submission_date
            GROUP BY hacker_id
            ORDER BY COUNT(*) DESC, hacker_id
        )
    )
FROM (SELECT DISTINCT submission_date FROM Submissions) d
LEFT JOIN valid v
    ON d.submission_date = v.submission_date
GROUP BY d.submission_date
ORDER BY d.submission_date;
