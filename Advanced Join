/*Interviews*/

WITH AggregatedViews AS (
    SELECT challenge_id, 
           SUM(total_views) as sum_tv, 
           SUM(total_unique_views) as sum_tuv
    FROM View_Stats
    GROUP BY challenge_id
),
AggregatedSubmissions AS (
    SELECT challenge_id, 
           SUM(total_submissions) as sum_ts, 
           SUM(total_accepted_submissions) as sum_tas
    FROM Submission_Stats
    GROUP BY challenge_id
)
SELECT 
    con.contest_id, 
    con.hacker_id, 
    con.name, 
    SUM(ISNULL(s_stats.sum_ts, 0)), 
    SUM(ISNULL(s_stats.sum_tas, 0)), 
    SUM(ISNULL(v_stats.sum_tv, 0)), 
    SUM(ISNULL(v_stats.sum_tuv, 0))
FROM Contests con
JOIN Colleges col ON con.contest_id = col.contest_id
JOIN Challenges cha ON col.college_id = cha.college_id
/* Using v_stats and s_stats instead of reserved keywords */
LEFT JOIN AggregatedViews v_stats ON cha.challenge_id = v_stats.challenge_id
LEFT JOIN AggregatedSubmissions s_stats ON cha.challenge_id = s_stats.challenge_id
GROUP BY con.contest_id, con.hacker_id, con.name
HAVING (SUM(ISNULL(s_stats.sum_ts, 0)) + 
        SUM(ISNULL(s_stats.sum_tas, 0)) + 
        SUM(ISNULL(v_stats.sum_tv, 0)) + 
        SUM(ISNULL(v_stats.sum_tuv, 0))) > 0
ORDER BY con.contest_id;

