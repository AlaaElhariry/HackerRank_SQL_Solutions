/*Print Prime Numbers*/

WITH Numbers AS (
    SELECT 2 AS Num
    UNION ALL
    SELECT Num + 1
    FROM Numbers
    WHERE Num < 1000
),
Primes AS (
    SELECT n1.Num
    FROM Numbers n1
    WHERE NOT EXISTS (
        SELECT 1
        FROM Numbers n2
        WHERE n2.Num < n1.Num
          AND n2.Num > 1
          AND n1.Num % n2.Num = 0
    )
)
SELECT STRING_AGG(CAST(Num AS VARCHAR), '&') 
       WITHIN GROUP (ORDER BY Num)
FROM Primes
OPTION (MAXRECURSION 1000);
