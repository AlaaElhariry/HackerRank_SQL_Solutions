/*Draw The Triangle 1*/
WITH cte AS (
    SELECT 20 AS n
    UNION ALL
    SELECT n - 1
    FROM cte
    WHERE n > 1
)
SELECT REPLICATE('* ', n)
FROM cte
ORDER BY n DESC
OPTION (MAXRECURSION 100);
----------------------------------------------------------------------------
/*Draw The Triangle 2*/
WITH cte AS (
    SELECT 1 AS n
    UNION ALL
    SELECT n + 1
    FROM cte
    WHERE n < 20
)
SELECT REPLICATE('* ', n)
FROM cte
ORDER BY n
OPTION (MAXRECURSION 100);
