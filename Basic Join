/*Contest Leaderboard*/

WITH MaxScores AS (
    SELECT 
        hacker_id,
        challenge_id,
        MAX(score) AS max_score
    FROM Submissions
    GROUP BY 
        hacker_id,
        challenge_id
),

TotalScores AS (
    SELECT 
        hacker_id,
        SUM(max_score) AS total_score
    FROM MaxScores
    GROUP BY 
        hacker_id
)

SELECT 
    H.hacker_id,
    H.name,
    T.total_score
FROM Hackers H
JOIN TotalScores T
    ON H.hacker_id = T.hacker_id
WHERE T.total_score > 0
ORDER BY 
    T.total_score DESC,
    H.hacker_id ASC;
