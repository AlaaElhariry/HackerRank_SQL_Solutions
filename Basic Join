/*Ollivander's Inventory*/

SELECT 
    W.id,
    WP.age,
    W.coins_needed,
    W.power
FROM Wands W
JOIN Wands_Property WP 
    ON W.code = WP.code
WHERE WP.is_evil = 0
AND W.coins_needed = (
    SELECT MIN(W2.coins_needed)
    FROM Wands W2
    JOIN Wands_Property WP2 
        ON W2.code = WP2.code
    WHERE WP2.is_evil = 0
      AND W2.power = W.power
      AND WP2.age = WP.age
)
ORDER BY 
    W.power DESC,
    WP.age DESC;

----------------------------------------------
/*Challenges*/

SELECT 
    H.hacker_id,
    H.name,
    COUNT(C.challenge_id) AS total_challenges
FROM Hackers H
JOIN Challenges C 
    ON H.hacker_id = C.hacker_id
GROUP BY H.hacker_id, H.name
HAVING 
    COUNT(C.challenge_id) = (
        SELECT MAX(cnt)
        FROM (
            SELECT COUNT(*) AS cnt
            FROM Challenges
            GROUP BY hacker_id
        ) t
    )
    OR
    COUNT(C.challenge_id) IN (
        SELECT cnt
        FROM (
            SELECT COUNT(*) AS cnt
            FROM Challenges
            GROUP BY hacker_id
        ) t
        GROUP BY cnt
        HAVING COUNT(cnt) = 1
    )
ORDER BY 
    total_challenges DESC,
    H.hacker_id ASC;

